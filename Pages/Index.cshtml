@page
@model IndexModel
@{
    // no shared layout needed, just one standalone page for activity 1
    Layout = null;
    ViewData["Title"] = "Student Registration - PUP Bataan";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    
    <!-- fonts from google fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />

    <!-- tailwind cdn so we don't have to write raw css manually -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        // custom tailwind colors for pup (maroon and gold)
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        pup: {
                            maroon: '#781214',
                            maroondark: '#5a0d0f',
                            maroonlight: '#8f1619',
                            gold: '#F1B82D',
                            goldlight: '#fed766',
                            golddark: '#b45309'
                        }
                    },
                    fontFamily: {
                        sans: ['Plus Jakarta Sans', 'Segoe UI', 'system-ui', 'sans-serif']
                    },
                    boxShadow: {
                        'card-glow': '0 20px 45px -12px rgba(120, 18, 20, 0.12), 0 8px 20px -6px rgba(241, 184, 45, 0.12)'
                    }
                }
            }
        }
    </script>
    
    <!-- simple animation styles -->
    <style>
        body {
            font-family: 'Plus Jakarta Sans', 'Segoe UI', system-ui, sans-serif;
        }

        /* subtle fade in so it doesn't pop in abruptly */
        @@keyframes slideUpFade {
            from {
                opacity: 0;
                transform: translateY(12px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .animate-card-enter {
            animation: slideUpFade 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }

        .animate-details-enter {
            animation: slideUpFade 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }
    </style>
</head>
<body class="bg-gradient-to-br from-amber-50/30 via-slate-100 to-amber-100/20 min-h-screen py-10 px-4 text-slate-800 antialiased flex flex-col justify-between items-center selection:bg-pup-maroon selection:text-pup-gold relative">

    <!-- some ambient glow in the background just to look nice -->
    <div class="fixed top-0 left-1/4 w-96 h-96 bg-pup-maroon/5 rounded-full blur-3xl pointer-events-none -z-10"></div>
    <div class="fixed bottom-0 right-1/4 w-96 h-96 bg-pup-gold/10 rounded-full blur-3xl pointer-events-none -z-10"></div>

    <!-- top colored accent line matching pup colors -->
    <div class="fixed top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-pup-maroon via-pup-gold to-pup-maroon z-50"></div>

    <!-- main page wrapper container -->
    <div class="w-full max-w-2xl mx-auto animate-card-enter">

        <!-- header section with pup logo and campus name -->
        <header class="text-center mb-6">
            <!-- school logo -->
            <div class="inline-flex items-center justify-center mb-2.5">
                <img src="https://www.pngkey.com/png/detail/52-528919_the-pup-logo-polytechnic-university-of-the-philippines.png" 
                     alt="The Pup Logo - Polytechnic University Of The Philippines Logo@pngkey.com" 
                     class="h-16 md:h-20 w-auto object-contain drop-shadow-sm transition-transform duration-300 hover:scale-105" />
            </div>

            <!-- campus and university title -->
            <h1 class="text-3xl md:text-4xl font-black text-pup-maroon tracking-wider uppercase drop-shadow-sm">
                PUP BATAAN
            </h1>
            <div class="inline-flex items-center justify-center gap-2 mt-1">
                <span class="h-0.5 w-6 bg-pup-gold rounded-full"></span>
                <p class="text-xs md:text-sm font-bold text-pup-golddark tracking-widest uppercase">
                    Polytechnic University of the Philippines
                </p>
                <span class="h-0.5 w-6 bg-pup-gold rounded-full"></span>
            </div>
        </header>

        <!-- main card container -->
        <main class="w-full bg-white rounded-2xl shadow-card-glow border border-amber-200/80 overflow-hidden transition-all duration-300 hover:shadow-2xl">
            
            <!-- card header banner (changes title between student registration and details) -->
            <div class="bg-gradient-to-r from-pup-maroon via-pup-maroonlight to-pup-maroon text-pup-gold font-extrabold text-center py-4 px-6 text-xl md:text-2xl tracking-wider uppercase shadow-md flex items-center justify-center gap-2.5 border-b-2 border-pup-gold/40">
                <svg class="w-6 h-6 text-pup-gold drop-shadow-sm" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                </svg>
                <span class="drop-shadow-sm tracking-wide">@(Model.IsSubmitted ? "REGISTRATION DETAILS" : "STUDENT REGISTRATION")</span>
            </div>

            @* show the input form if it's not yet submitted *@
            @if (!Model.IsSubmitted)
            {
                <!-- registration form starts here -->
                <form method="post" asp-page-handler="Submit" class="p-6 md:p-8 space-y-5" id="registrationForm">
                    
                    <!-- short reminder note for the user -->
                    <div class="flex items-center gap-2.5 p-3 rounded-xl bg-amber-50/70 border border-amber-200/80 text-amber-950">
                        <svg class="w-5 h-5 text-pup-golddark flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"></path>
                        </svg>
                        <p class="text-xs md:text-sm font-medium">
                            Please enter the student's information below.
                        </p>
                    </div>

                    <!-- 1. First Name -->
                    <div class="space-y-1.5">
                        <label asp-for="Student.FirstName" class="flex items-center gap-2 text-xs md:text-sm font-extrabold uppercase tracking-wider text-slate-700">
                            <svg class="w-4 h-4 text-pup-maroon flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                            </svg>
                            <span>First Name</span>
                        </label>
                        <div class="relative rounded-xl shadow-sm transition-all duration-200">
                            <input type="text"
                                   asp-for="Student.FirstName"
                                   id="firstName"
                                   placeholder="Enter first name"
                                   class="w-full px-4 py-2.5 bg-slate-50/70 hover:bg-slate-50 focus:bg-white border border-slate-300 hover:border-amber-400/80 rounded-xl text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-4 focus:ring-pup-gold/25 focus:border-pup-maroon shadow-sm focus:shadow-md transition-all duration-200" />
                        </div>
                        <!-- quick error alert if they type numbers or symbols -->
                        <p id="firstNameWarning" class="hidden text-xs text-red-600 font-medium flex items-center gap-1 animate-details-enter">
                            <svg class="w-3.5 h-3.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"></path>
                            </svg>
                            <span>Only letters and spaces are allowed. Numbers and symbols are not permitted.</span>
                        </p>
                    </div>

                    <!-- 2. Middle Initial -->
                    <div class="space-y-1.5">
                        <label asp-for="Student.MiddleInitial" class="flex items-center gap-2 text-xs md:text-sm font-extrabold uppercase tracking-wider text-slate-700">
                            <svg class="w-4 h-4 text-pup-maroon flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V8a2 2 0 00-2-2h-5m-4 0V5a2 2 0 114 0v1m-4 0a2 2 0 104 0m-5 8a2 2 0 100-4 2 2 0 000 4zm0 0c1.306 0 2.417.835 2.83 2M9 14a3.001 3.001 0 00-2.83 2M15 11h3m-3 4h2"></path>
                            </svg>
                            <span>Middle Initial</span>
                        </label>
                        <div class="relative rounded-xl shadow-sm transition-all duration-200">
                            <input type="text"
                                   asp-for="Student.MiddleInitial"
                                   id="middleInitial"
                                   placeholder="Enter middle initial"
                                   class="w-full px-4 py-2.5 bg-slate-50/70 hover:bg-slate-50 focus:bg-white border border-slate-300 hover:border-amber-400/80 rounded-xl text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-4 focus:ring-pup-gold/25 focus:border-pup-maroon shadow-sm focus:shadow-md transition-all duration-200" />
                        </div>
                        <p id="middleInitialWarning" class="hidden text-xs text-red-600 font-medium flex items-center gap-1 animate-details-enter">
                            <svg class="w-3.5 h-3.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"></path>
                            </svg>
                            <span>Only letters and spaces are allowed. Numbers and symbols are not permitted.</span>
                        </p>
                    </div>

                    <!-- 3. Last Name -->
                    <div class="space-y-1.5">
                        <label asp-for="Student.LastName" class="flex items-center gap-2 text-xs md:text-sm font-extrabold uppercase tracking-wider text-slate-700">
                            <svg class="w-4 h-4 text-pup-maroon flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
                            </svg>
                            <span>Last Name</span>
                        </label>
                        <div class="relative rounded-xl shadow-sm transition-all duration-200">
                            <input type="text"
                                   asp-for="Student.LastName"
                                   id="lastName"
                                   placeholder="Enter last name"
                                   class="w-full px-4 py-2.5 bg-slate-50/70 hover:bg-slate-50 focus:bg-white border border-slate-300 hover:border-amber-400/80 rounded-xl text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-4 focus:ring-pup-gold/25 focus:border-pup-maroon shadow-sm focus:shadow-md transition-all duration-200" />
                        </div>
                        <p id="lastNameWarning" class="hidden text-xs text-red-600 font-medium flex items-center gap-1 animate-details-enter">
                            <svg class="w-3.5 h-3.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"></path>
                            </svg>
                            <span>Only letters and spaces are allowed. Numbers and symbols are not permitted.</span>
                        </p>
                    </div>

                    <!-- 4. Complete Address -->
                    <div class="space-y-1.5">
                        <label asp-for="Student.CompleteAddress" class="flex items-center gap-2 text-xs md:text-sm font-extrabold uppercase tracking-wider text-slate-700">
                            <svg class="w-4 h-4 text-pup-maroon flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                            </svg>
                            <span>Complete Address</span>
                        </label>
                        <div class="relative rounded-xl shadow-sm transition-all duration-200">
                            <textarea asp-for="Student.CompleteAddress"
                                      id="completeAddress"
                                      rows="3"
                                      placeholder="Enter complete address"
                                      class="w-full p-3.5 bg-slate-50/70 hover:bg-slate-50 focus:bg-white border border-slate-300 hover:border-amber-400/80 rounded-xl text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-4 focus:ring-pup-gold/25 focus:border-pup-maroon shadow-sm focus:shadow-md transition-all duration-200 resize-y"></textarea>
                        </div>
                    </div>

                    <!-- 5. Sex dropdown -->
                    <div class="space-y-1.5">
                        <label asp-for="Student.Sex" class="flex items-center gap-2 text-xs md:text-sm font-extrabold uppercase tracking-wider text-slate-700">
                            <svg class="w-4 h-4 text-pup-maroon flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                            </svg>
                            <span>Sex</span>
                        </label>
                        <div class="relative rounded-xl shadow-sm transition-all duration-200">
                            <select asp-for="Student.Sex"
                                    id="sexSelect"
                                    class="w-full pl-4 pr-10 py-2.5 bg-slate-50/70 hover:bg-slate-50 focus:bg-white border border-slate-300 hover:border-amber-400/80 rounded-xl text-sm text-slate-800 focus:outline-none focus:ring-4 focus:ring-pup-gold/25 focus:border-pup-maroon shadow-sm focus:shadow-md transition-all duration-200 appearance-none cursor-pointer">
                                <option value="">-- Select Sex --</option>
                                <option value="Feminine">Feminine</option>
                                <option value="Masculine">Masculine</option>
                                <option value="Prefer not to say">Prefer not to say</option>
                            </select>
                            <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-3.5 text-slate-400">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                                </svg>
                            </div>
                        </div>
                    </div>

                    <!-- 6. Birthday (auto-formats with slashes) -->
                    <div class="space-y-1.5">
                        <div class="flex items-center justify-between">
                            <label asp-for="Student.Birthday" class="flex items-center gap-2 text-xs md:text-sm font-extrabold uppercase tracking-wider text-slate-700">
                                <svg class="w-4 h-4 text-pup-maroon flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                                </svg>
                                <span>Birthday</span>
                            </label>
                            <span class="inline-flex items-center gap-1 text-[11px] font-semibold text-amber-800 bg-amber-50 px-2 py-0.5 rounded-md border border-amber-200">
                                <svg class="w-3 h-3 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                </svg>
                                <span>Format: mm/dd/yyyy</span>
                            </span>
                        </div>
                        <div class="relative rounded-xl shadow-sm transition-all duration-200">
                            <input type="text"
                                   asp-for="Student.Birthday"
                                   id="birthdayInput"
                                   placeholder="mm/dd/yyyy"
                                   maxlength="10"
                                   class="w-full px-4 py-2.5 bg-slate-50/70 hover:bg-slate-50 focus:bg-white border border-slate-300 hover:border-amber-400/80 rounded-xl text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-4 focus:ring-pup-gold/25 focus:border-pup-maroon shadow-sm focus:shadow-md transition-all duration-200 font-mono" />
                        </div>
                    </div>

                    <!-- 7. Program dropdown -->
                    <div class="space-y-1.5">
                        <label asp-for="Student.Program" class="flex items-center gap-2 text-xs md:text-sm font-extrabold uppercase tracking-wider text-slate-700">
                            <svg class="w-4 h-4 text-pup-maroon flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z"></path>
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"></path>
                            </svg>
                            <span>Program</span>
                        </label>
                        <div class="relative rounded-xl shadow-sm transition-all duration-200">
                            <select asp-for="Student.Program"
                                    id="programSelect"
                                    class="w-full pl-4 pr-10 py-2.5 bg-slate-50/70 hover:bg-slate-50 focus:bg-white border border-slate-300 hover:border-amber-400/80 rounded-xl text-sm text-slate-800 focus:outline-none focus:ring-4 focus:ring-pup-gold/25 focus:border-pup-maroon shadow-sm focus:shadow-md transition-all duration-200 appearance-none cursor-pointer">
                                <option value="">-- Select Program --</option>
                                <option value="BEED">BEED</option>
                                <option value="BSA">BSA</option>
                                <option value="BSBA">BSBA</option>
                                <option value="BSENT">BSENT</option>
                                <option value="BSIE">BSIE</option>
                                <option value="BSIT">BSIT</option>
                                <option value="BSMA">BSMA</option>
                                <option value="DIT">DIT</option>
                                <option value="DOMT-LOM">DOMT-LOM</option>
                            </select>
                            <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-3.5 text-slate-400">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                                </svg>
                            </div>
                        </div>
                    </div>

                    <!-- form action buttons -->
                    <div class="flex items-center gap-3 pt-3">
                        <!-- submit button -->
                        <button type="submit"
                                asp-page-handler="Submit"
                                class="inline-flex items-center gap-2 bg-gradient-to-r from-amber-400 via-pup-gold to-yellow-500 hover:from-amber-500 hover:to-yellow-600 active:scale-[0.98] text-pup-maroon font-black py-2.5 px-7 rounded-xl shadow-md hover:shadow-lg shadow-amber-500/25 transition-all duration-150 text-sm uppercase cursor-pointer border border-amber-300">
                            <svg class="w-4 h-4 text-pup-maroon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.8" d="M5 13l4 4L19 7"></path>
                            </svg>
                            <span>SUBMIT</span>
                        </button>

                        <!-- clear button to reset the form -->
                        <button type="submit"
                                asp-page-handler="Clear"
                                formnovalidate
                                class="inline-flex items-center gap-2 bg-gradient-to-r from-amber-50 to-yellow-100/70 hover:from-amber-100 hover:to-yellow-200/80 active:scale-[0.98] text-amber-950 font-bold py-2.5 px-6 rounded-xl border border-amber-300 hover:border-amber-400 shadow-sm hover:shadow transition-all duration-150 text-sm cursor-pointer">
                            <svg class="w-4 h-4 text-amber-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
                            </svg>
                            <span>Clear</span>
                        </button>
                    </div>

                </form>
            }
            else
            {
                <!-- once submitted: form inputs hide and submitted info is displayed here -->
                <div class="animate-details-enter p-6 md:p-8 bg-amber-50/20 space-y-6" id="registrationDetailsSection">
                    
                    <!-- list showing all 7 submitted fields with their icons and values -->
                    <div class="bg-white rounded-2xl p-6 shadow-sm border border-amber-200/80 divide-y divide-amber-100 space-y-3.5 text-sm md:text-base">
                        
                        <!-- first name -->
                        <div class="pt-3 first:pt-0 flex flex-col sm:flex-row sm:items-center">
                            <span class="font-bold text-slate-900 w-48 flex-shrink-0 flex items-center gap-2">
                                <svg class="w-4 h-4 text-pup-maroon flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                                </svg>
                                <span>First Name:</span>
                            </span>
                            <span class="text-slate-800 font-semibold mt-1 sm:mt-0">@Model.Student.FirstName</span>
                        </div>

                        <!-- middle initial -->
                        <div class="pt-3 flex flex-col sm:flex-row sm:items-center">
                            <span class="font-bold text-slate-900 w-48 flex-shrink-0 flex items-center gap-2">
                                <svg class="w-4 h-4 text-pup-maroon flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V8a2 2 0 00-2-2h-5m-4 0V5a2 2 0 114 0v1m-4 0a2 2 0 104 0m-5 8a2 2 0 100-4 2 2 0 000 4zm0 0c1.306 0 2.417.835 2.83 2M9 14a3.001 3.001 0 00-2.83 2M15 11h3m-3 4h2"></path>
                                </svg>
                                <span>Middle Initial:</span>
                            </span>
                            <span class="text-slate-800 font-semibold mt-1 sm:mt-0">@Model.Student.MiddleInitial</span>
                        </div>

                        <!-- last name -->
                        <div class="pt-3 flex flex-col sm:flex-row sm:items-center">
                            <span class="font-bold text-slate-900 w-48 flex-shrink-0 flex items-center gap-2">
                                <svg class="w-4 h-4 text-pup-maroon flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
                                </svg>
                                <span>Last Name:</span>
                            </span>
                            <span class="text-slate-800 font-semibold mt-1 sm:mt-0">@Model.Student.LastName</span>
                        </div>

                        <!-- complete address -->
                        <div class="pt-3 flex flex-col sm:flex-row sm:items-center">
                            <span class="font-bold text-slate-900 w-48 flex-shrink-0 flex items-center gap-2">
                                <svg class="w-4 h-4 text-pup-maroon flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                </svg>
                                <span>Complete Address:</span>
                            </span>
                            <span class="text-slate-800 font-semibold mt-1 sm:mt-0">@Model.Student.CompleteAddress</span>
                        </div>

                        <!-- sex -->
                        <div class="pt-3 flex flex-col sm:flex-row sm:items-center">
                            <span class="font-bold text-slate-900 w-48 flex-shrink-0 flex items-center gap-2">
                                <svg class="w-4 h-4 text-pup-maroon flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                                </svg>
                                <span>Sex:</span>
                            </span>
                            <span class="text-slate-800 font-semibold mt-1 sm:mt-0">@Model.Student.Sex</span>
                        </div>

                        <!-- birthday -->
                        <div class="pt-3 flex flex-col sm:flex-row sm:items-center">
                            <span class="font-bold text-slate-900 w-48 flex-shrink-0 flex items-center gap-2">
                                <svg class="w-4 h-4 text-pup-maroon flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                                </svg>
                                <span>Birthday:</span>
                            </span>
                            <span class="text-slate-800 font-semibold mt-1 sm:mt-0">@Model.Student.Birthday</span>
                        </div>

                        <!-- program -->
                        <div class="pt-3 flex flex-col sm:flex-row sm:items-center">
                            <span class="font-bold text-slate-900 w-48 flex-shrink-0 flex items-center gap-2">
                                <svg class="w-4 h-4 text-pup-maroon flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z"></path>
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"></path>
                                </svg>
                                <span>Program:</span>
                            </span>
                            <span class="inline-flex items-center px-3 py-1 rounded-md text-xs md:text-sm font-black bg-amber-100 text-pup-maroon border border-amber-300 mt-1 sm:mt-0">
                                @Model.Student.Program
                            </span>
                        </div>

                    </div>

                    <!-- clear button to reset everything and bring the input form back -->
                    <form method="post" asp-page-handler="Clear" class="pt-2 flex justify-start">
                        <button type="submit"
                                class="inline-flex items-center gap-2 bg-gradient-to-r from-amber-400 via-pup-gold to-yellow-500 hover:from-amber-500 hover:to-yellow-600 active:scale-[0.98] text-pup-maroon font-black py-2.5 px-7 rounded-xl shadow-md hover:shadow-lg shadow-amber-500/25 transition-all duration-150 text-sm uppercase cursor-pointer border border-amber-300">
                            <svg class="w-4 h-4 text-pup-maroon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
                            </svg>
                            <span>Clear</span>
                        </button>
                    </form>

                </div>
            }

        </main>

        <!-- required footer info -->
        <footer class="text-center mt-6 text-slate-500 text-xs md:text-sm font-semibold tracking-wide">
            &copy; BSIT 4 – 2026
        </footer>

    </div>

    <!-- simple client-side javascript helpers -->
    <script>
        // automatically adds slashes as the user types the birthday digits (mm/dd/yyyy)
        const bdayInput = document.getElementById('birthdayInput');
        if (bdayInput) {
            bdayInput.addEventListener('keydown', function(e) {
                if (e.key === 'Backspace') {
                    const val = this.value;
                    const start = this.selectionStart;
                    const end = this.selectionEnd;
                    if (start === end && start > 0 && val[start - 1] === '/') {
                        e.preventDefault();
                        this.value = val.slice(0, start - 2) + val.slice(end);
                        this.setSelectionRange(start - 2, start - 2);
                    }
                }
            });

            bdayInput.addEventListener('input', function(e) {
                let v = this.value.replace(/\D/g, '');
                if (v.length > 8) {
                    v = v.slice(0, 8);
                }

                if (v.length === 0) {
                    this.value = '';
                    return;
                }

                // don't auto-append slashes if user is pressing backspace or deleting
                if (e.inputType === 'deleteContentBackward' || e.inputType === 'deleteContentForward') {
                    if (v.length <= 2) {
                        this.value = v;
                    } else if (v.length <= 4) {
                        this.value = v.slice(0, 2) + '/' + v.slice(2);
                    } else {
                        this.value = v.slice(0, 2) + '/' + v.slice(2, 4) + '/' + v.slice(4);
                    }
                    return;
                }

                if (v.length === 1) {
                    this.value = v;
                } else if (v.length === 2) {
                    this.value = v + '/';
                } else if (v.length === 3) {
                    this.value = v.slice(0, 2) + '/' + v.slice(2);
                } else if (v.length === 4) {
                    this.value = v.slice(0, 2) + '/' + v.slice(2, 4) + '/';
                } else {
                    this.value = v.slice(0, 2) + '/' + v.slice(2, 4) + '/' + v.slice(4);
                }
            });
        }

        // blocks numbers and symbols on name fields, only allows letters, spaces, and periods
        function setupNameValidation(inputId, warningId) {
            const input = document.getElementById(inputId);
            const warning = document.getElementById(warningId);
            if (!input || !warning) return;

            let timeout = null;
            function showWarning() {
                warning.classList.remove('hidden');
                input.classList.add('border-red-400', 'focus:ring-red-500/20', 'focus:border-red-500');
                input.classList.remove('border-slate-300', 'focus:ring-pup-gold/25', 'focus:border-pup-maroon');

                if (timeout) clearTimeout(timeout);
                timeout = setTimeout(() => {
                    warning.classList.add('hidden');
                    input.classList.remove('border-red-400', 'focus:ring-red-500/20', 'focus:border-red-500');
                    input.classList.add('border-slate-300', 'focus:ring-pup-gold/25', 'focus:border-pup-maroon');
                }, 3000);
            }

            function hideWarning() {
                warning.classList.add('hidden');
                input.classList.remove('border-red-400', 'focus:ring-red-500/20', 'focus:border-red-500');
                input.classList.add('border-slate-300', 'focus:ring-pup-gold/25', 'focus:border-pup-maroon');
            }

            input.addEventListener('keypress', function(e) {
                if (e.ctrlKey || e.altKey || e.metaKey || e.key.length !== 1) return;
                const validRegex = /^[a-zA-Z\s\u00C0-\u017F.]$/;
                if (!validRegex.test(e.key)) {
                    e.preventDefault();
                    showWarning();
                } else {
                    hideWarning();
                }
            });

            input.addEventListener('input', function() {
                const invalidRegex = /[^a-zA-Z\s\u00C0-\u017F.]/g;
                if (invalidRegex.test(this.value)) {
                    this.value = this.value.replace(invalidRegex, '');
                    showWarning();
                }
            });
        }

        setupNameValidation('firstName', 'firstNameWarning');
        setupNameValidation('middleInitial', 'middleInitialWarning');
        setupNameValidation('lastName', 'lastNameWarning');
    </script>

</body>
</html>
