@page
@model IndexModel
@{
    Layout = null;
    ViewData["Title"] = "Student Registration - PUP Bataan";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
        }
    </style>
</head>
<body class="bg-gray-100 min-h-screen flex flex-col justify-between py-6 px-4">

    <!-- Header -->
    <header class="text-center mt-2 mb-4">
        <h1 class="text-2xl md:text-3xl font-extrabold text-gray-900 tracking-wide uppercase">
            PUP BATAAN
        </h1>
    </header>

    <!-- Main Container -->
    <main class="w-full">
        <!-- Centered Card Container -->
        <div class="max-w-3xl mx-auto my-8 bg-white rounded-lg shadow-md border border-gray-200 overflow-hidden">
            
            <!-- Form Banner -->
            <div class="bg-blue-600 text-white font-bold text-center py-3 text-lg md:text-xl tracking-wider uppercase">
                STUDENT REGISTRATION
            </div>

            <!-- Form Content -->
            <form method="post" asp-page-handler="Submit" class="p-6 md:p-8 space-y-4">
                
                <!-- Sub-header text -->
                <p class="text-gray-500 text-sm mb-4">
                    Please enter the student's information below.
                </p>

                <!-- First Name, Middle Initial, Last Name -->
                <div class="grid grid-cols-1 md:grid-cols-12 gap-4">
                    <div class="md:col-span-5">
                        <label asp-for="Student.FirstName" class="block text-sm font-semibold text-gray-700 mb-1">First Name</label>
                        <input type="text"
                               asp-for="Student.FirstName"
                               placeholder="Enter first name"
                               class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-sm text-gray-900 placeholder-gray-400" />
                    </div>
                    <div class="md:col-span-2">
                        <label asp-for="Student.MiddleInitial" class="block text-sm font-semibold text-gray-700 mb-1">Middle Initial</label>
                        <input type="text"
                               asp-for="Student.MiddleInitial"
                               maxlength="5"
                               placeholder="Enter middle initial"
                               class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-sm text-gray-900 placeholder-gray-400" />
                    </div>
                    <div class="md:col-span-5">
                        <label asp-for="Student.LastName" class="block text-sm font-semibold text-gray-700 mb-1">Last Name</label>
                        <input type="text"
                               asp-for="Student.LastName"
                               placeholder="Enter last name"
                               class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-sm text-gray-900 placeholder-gray-400" />
                    </div>
                </div>

                <!-- Complete Address -->
                <div>
                    <label asp-for="Student.CompleteAddress" class="block text-sm font-semibold text-gray-700 mb-1">Complete Address</label>
                    <textarea asp-for="Student.CompleteAddress"
                              rows="3"
                              placeholder="Enter complete address"
                              class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-sm text-gray-900 placeholder-gray-400"></textarea>
                </div>

                <!-- Sex, Birthday, Program -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div>
                        <label asp-for="Student.Sex" class="block text-sm font-semibold text-gray-700 mb-1">Sex</label>
                        <select asp-for="Student.Sex"
                                class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-sm text-gray-900 bg-white">
                            <option value="">-- Select Sex --</option>
                            <option value="Feminine">Feminine</option>
                            <option value="Masculine">Masculine</option>
                            <option value="Prefer not to say">Prefer not to say</option>
                        </select>
                    </div>

                    <div>
                        <label asp-for="Student.Birthday" class="block text-sm font-semibold text-gray-700 mb-1">Birthday</label>
                        <input type="text"
                               asp-for="Student.Birthday"
                               placeholder="mm/dd/yyyy"
                               class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-sm text-gray-900 placeholder-gray-400" />
                        <p class="text-xs text-gray-500 mt-1">Format: mm/dd/yyyy</p>
                    </div>

                    <div>
                        <label asp-for="Student.Program" class="block text-sm font-semibold text-gray-700 mb-1">Program</label>
                        <select asp-for="Student.Program"
                                class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-sm text-gray-900 bg-white">
                            <option value="">-- Select Program --</option>
                            <option value="BEED">BEED</option>
                            <option value="BSA">BSA</option>
                            <option value="BSBA">BSBA</option>
                            <option value="BSENT">BSENT</option>
                            <option value="BSIE">BSIE</option>
                            <option value="BSIT">BSIT</option>
                            <option value="BSMA">BSMA</option>
                            <option value="DIT">DIT</option>
                            <option value="DOMT-LOM">DOMT-LOM</option>
                        </select>
                    </div>
                </div>

                <!-- Buttons & Actions -->
                <div class="flex items-center space-x-3 pt-4">
                    <button type="submit"
                            asp-page-handler="Submit"
                            class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded transition duration-150 cursor-pointer shadow-sm">
                        SUBMIT
                    </button>
                    <button type="submit"
                            asp-page-handler="Clear"
                            formnovalidate
                            class="bg-gray-500 hover:bg-gray-600 text-white font-bold py-2 px-4 rounded transition duration-150 cursor-pointer shadow-sm">
                        Clear
                    </button>
                </div>
            </form>

            <!-- Displaying Submitted Data (Conditionally Rendered) -->
            @if (Model.IsSubmitted)
            {
                <div class="border-t border-gray-200">
                    <!-- Details Banner -->
                    <div class="bg-emerald-700 text-white font-bold text-center py-3 text-lg md:text-xl tracking-wider uppercase">
                        REGISTRATION DETAILS
                    </div>

                    <!-- Details Content -->
                    <div class="p-6 md:p-8 bg-gray-50/75 space-y-2 text-sm md:text-base text-gray-800">
                        <div>
                            <span class="font-bold text-gray-900">First Name:</span>
                            <span class="ml-1">@Model.Student.FirstName</span>
                        </div>
                        <div>
                            <span class="font-bold text-gray-900">Middle Initial:</span>
                            <span class="ml-1">@Model.Student.MiddleInitial</span>
                        </div>
                        <div>
                            <span class="font-bold text-gray-900">Last Name:</span>
                            <span class="ml-1">@Model.Student.LastName</span>
                        </div>
                        <div>
                            <span class="font-bold text-gray-900">Complete Address:</span>
                            <span class="ml-1">@Model.Student.CompleteAddress</span>
                        </div>
                        <div>
                            <span class="font-bold text-gray-900">Sex:</span>
                            <span class="ml-1">@Model.Student.Sex</span>
                        </div>
                        <div>
                            <span class="font-bold text-gray-900">Birthday:</span>
                            <span class="ml-1">@Model.Student.Birthday</span>
                        </div>
                        <div>
                            <span class="font-bold text-gray-900">Program:</span>
                            <span class="ml-1">@Model.Student.Program</span>
                        </div>
                    </div>
                </div>
            }

        </div>
    </main>

    <!-- Footer -->
    <footer class="text-center py-4 text-gray-600 text-sm">
        &copy;BSIT 4 – 2026
    </footer>

</body>
</html>
